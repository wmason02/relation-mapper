<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shortest Path</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <%- include('partials/header') %>
    <div class="container">
        <div class="hero">
            <span class="eyebrow">Shortest path</span>
            <div class="path-summary">
                <span class="name-pill"><%= start %></span>
                <span class="connector">&rarr;</span>
                <span class="name-pill"><%= end %></span>
            </div>
        </div>
        <% if (images.length > 0) { %>
            <div class="path-container">
                <% for (let i = 0; i < images.length; i++) { %>
                    <div class="path-item">
                        <img src="<%= images[i].image %>" alt="Path Image <%= i + 1 %>" >
                        <p class="path-caption"><%= images[i].caption %></p>
                    </div>
                    <% if (i < images.length - 1) { %>
                        <div class="path-arrow">&rarr;</div>
                    <% } %>
                <% } %>
            </div>
        <% } else { %>
            <p class="empty-state">No path found between <%= start %> and <%= end %>.</p>
        <% } %>

        <a href="/" class="btn btn-secondary">Search Again</a>
    </div>
</body>
</html>

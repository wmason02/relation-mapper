<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= person %>'s Connections</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <%- include('partials/header') %>
    <div class="container">
        <div class="hero">
            <span class="eyebrow">Direct connections</span>
            <h1><%= person %></h1>
            <p class="subtitle"><%= connections.length %> direct connection<%= connections.length === 1 ? '' : 's' %> found</p>
        </div>

        <% if (connections.length > 0) { %>
            <div class="connections-container">
                <% connections.forEach(connection => { %>
                    <div class="connection-item">
                        <img src="<%= connection.image %>" alt="<%= connection.name %>">
                        <p><%= connection.name %></p>
                    </div>
                <% }) %>
            </div>
        <% } else { %>
            <p class="empty-state">No connections found.</p>
        <% } %>

        <a href="/" class="btn btn-secondary">Go Back</a>
    </div>
</body>
</html>

<header class="site-header">
    <a href="/" class="brand">Shortest Path</a>
    <nav class="site-nav">
        <a href="/" data-path="/">Find Path</a>
        <a href="/upload" data-path="/upload">Add Connection</a>
    </nav>
</header>
<script>
    document.querySelectorAll('.site-nav a').forEach(link => {
        if (link.dataset.path === window.location.pathname) {
            link.classList.add('active');
        }
    });
</script>

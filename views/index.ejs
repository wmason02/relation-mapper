<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shortest Path Finder</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <%- include('partials/header') %>
    <div class="container">
        <div class="hero">
            <h1>Find the Shortest Path Between Two People</h1>
            <p class="subtitle">Pick a start and an end person — we'll trace the shortest chain of shared photos linking them.</p>
        </div>

        <form id="path-form" action="/find_path" method="POST">
            <div class="field">
                <label for="start-name">Start Person</label>
                <input type="text" id="start-name" name="startName" placeholder="Search a name..." autocomplete="off" required>
                <input type="hidden" id="start-id" name="startId">
            </div>
            <div class="field">
                <label for="end-name">End Person</label>
                <input type="text" id="end-name" name="endName" placeholder="Search a name..." autocomplete="off" required>
                <input type="hidden" id="end-id" name="endId">
            </div>
            <div class="form-buttons">
                <button type="submit" class="btn full-width">Find Path</button>

                <div class="bottom-buttons">
                    <button type="button" id="random-pair-btn" class="btn btn-outline">Random</button>
                    <button type="button" id="view-connections-btn" class="btn btn-outline">View Connections</button>
                </div>
            </div>
        </form>

        <script src="/autocomplete.js"></script>
        <script>
            document.addEventListener('DOMContentLoaded', function() {
                const startInput = document.getElementById('start-name');
                const endInput = document.getElementById('end-name');
                const startIdField = document.getElementById('start-id');
                const endIdField = document.getElementById('end-id');

                const startAutocomplete = NameAutocomplete.attach(startInput, startIdField);
                const endAutocomplete = NameAutocomplete.attach(endInput, endIdField);

                document.getElementById('random-pair-btn').addEventListener('click', function() {
                    NameAutocomplete.loadNames().then(names => {
                        if (names.length < 2) return;
                        const index1 = Math.floor(Math.random() * names.length);
                        let index2;
                        do {
                            index2 = Math.floor(Math.random() * names.length);
                        } while (index2 === index1);
                        startAutocomplete.setValue(names[index1]);
                        endAutocomplete.setValue(names[index2]);
                    });
                });

                document.getElementById('view-connections-btn').addEventListener('click', () => {
                    if (!startIdField.value) {
                        alert('Please select a person first!');
                        return;
                    }
                    window.location.href = `/connections?personId=${startIdField.value}`;
                });
            });
        </script>
    </div>
</body>
</html>
